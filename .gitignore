# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
# Group project: committed on purpose so every teammate has working
# Turso/LLM credentials without separately requesting their own keys.
!.env.local
# Safe placeholder template (no real values) for anyone who doesn't have the
# real .env.local shared with them yet.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local.db

.vercel
