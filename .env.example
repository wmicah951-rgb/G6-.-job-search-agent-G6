# Copy this file to .env.local and fill in real values.
# The real .env.local is not committed to this repo (a platform-level safety
# control blocks committing files that match known secret/API-key patterns) —
# ask a teammate to share their working .env.local directly (Discord/Drive/
# etc.) for instant setup, or fill in your own values below.
#
# The live Vercel deployment already has all of these configured under
# Project Settings -> Environment Variables, so the deployed app works
# regardless of what's in this file locally.

# Optional — omit both to fall back to a local file DB (local.db), no account needed.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional — omit all LLM vars to run fully deterministic (keyword-based) matching.
# Set exactly one provider's key; LLM_PROVIDER picks explicitly if both are set.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Any other OpenAI-compatible model (OpenAI, Groq, OpenRouter, local Ollama at
# http://localhost:11434/v1, ...). Select it with LLM_PROVIDER=custom.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- LOCAL MODEL VIA OLLAMA (no API key needed) ----
# Ollama must be running (`ollama serve`) with a model pulled. List yours with:
#   curl http://localhost:11434/api/tags
# LLM_PROVIDER=custom
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=hf.co/ggml-org/Qwen2.5-Omni-7B-GGUF:Q4_K_M
# (LLM_API_KEY can stay empty for local models.)
